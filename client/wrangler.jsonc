{
  // Static-asset-only Worker: there is no server-side code, so no "main"
  // entry point — Cloudflare just serves the Vite build from ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaguepicker",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    // The app is a single page with no router; serve index.html rather than
    // a 404 if someone lands on an unknown path.
    "not_found_handling": "single-page-application"
  }
}
